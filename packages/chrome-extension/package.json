{
  "name": "@mcp-robotstudio/chrome-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Manifest V3 Chrome extension for ABB RobotStudio / IRC5 / OmniCore controllers via RWS 1.0 and 2.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "pack:zip": "node build.mjs --zip",
    "verify:zip": "node scripts/verify-zip.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node build.mjs && vitest run --no-file-parallelism"
  },
  "devDependencies": {
    "mcp-robotstudio": "*"
  }
}
