{
  "manifest_version": 3,
  "name": "MCP-ROBOTSTUDIO",
  "short_name": "MCP-RS",
  "version": "0.2.0",
  "description": "Instrumentacion para ABB RobotStudio e IRC5/OmniCore via RWS 1.0 y 2.0: telemetria, forense, osciloscopio, alcance y practicas.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; base-uri 'none'; frame-ancestors 'none';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "MCP-ROBOTSTUDIO",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
