{
  "manifest_version": 3,
  "name": "MCP-ROBOTSTUDIO RWS Monitor",
  "short_name": "RWS Monitor",
  "version": "0.1.0",
  "description": "Monitor de solo lectura para ABB RobotStudio / RobotWare 6 via RWS 1.0 (Digest MD5): estado, modulos, senales, eventos y simbolos.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "MCP-ROBOTSTUDIO RWS Monitor (Solo lectura)",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
