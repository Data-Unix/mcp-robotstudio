{
  "name": "mcp-robotstudio",
  "version": "0.2.0",
  "description": "ABB Robot Web Services client (RWS 1.0 IRC5/RW6 Digest, RWS 2.0 OmniCore/RW7-8 Basic over TLS) and stdio MCP server for ABB RobotStudio",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-robotstudio": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rws": {
      "types": "./dist/rws/index.d.ts",
      "import": "./dist/rws/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./kinematics": {
      "types": "./dist/kinematics/index.d.ts",
      "import": "./dist/kinematics/index.js"
    },
    "./rapid/validator": {
      "types": "./dist/rapid/validator.d.ts",
      "import": "./dist/rapid/validator.js"
    },
    "./rapid/diff": {
      "types": "./dist/rapid/diff.d.ts",
      "import": "./dist/rapid/diff.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    },
    "./forensics": {
      "types": "./dist/forensics.d.ts",
      "import": "./dist/forensics.js"
    },
    "./rspag": {
      "types": "./dist/rspag/audit.d.ts",
      "import": "./dist/rspag/audit.js"
    },
    "./rspag/zip": {
      "types": "./dist/rspag/zip.d.ts",
      "import": "./dist/rspag/zip.js"
    },
    "./practice": {
      "types": "./dist/practice/generator.d.ts",
      "import": "./dist/practice/generator.js"
    },
    "./testing": {
      "types": "./dist/testing/fake-rws-server.d.ts",
      "import": "./dist/testing/fake-rws-server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "abb",
    "abb-robotics",
    "robotstudio",
    "robotware",
    "robotware-6",
    "rws",
    "irc5",
    "rapid",
    "robotics",
    "industrial-automation",
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Data-Unix/mcp-robotstudio.git",
    "directory": "packages/mcp-robotstudio"
  },
  "homepage": "https://github.com/Data-Unix/mcp-robotstudio#readme",
  "bugs": {
    "url": "https://github.com/Data-Unix/mcp-robotstudio/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
